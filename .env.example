# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drag_gallery"

# MinIO / S3
MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_BUCKET="drag-gallery"
MINIO_ACCESS_KEY="minio"
MINIO_SECRET_KEY="minio123"
MINIO_REGION="us-east-1"
MINIO_USE_SSL="false"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"
# Optional: GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Telegram Upload-Benachrichtigungen (optional)
# Token vom @BotFather, Chat-ID vom @userinfobot (mehrere per Komma trennen)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_NOTIFY_ENABLED="true"
TELEGRAM_BATCH_MINUTES="5"

# Bildverarbeitung
# Gleichzeitig verarbeitete Bilder. Jeder Slot erzeugt seine 3 Größen parallel
# und braucht grob 1-1,5 GB RAM — 8 passt auf eine 32-GB-Instanz mit Reserve.
VARIANT_CONCURRENCY="8"

# Public
NEXT_PUBLIC_APP_NAME="Drag Gallery"
NEXT_PUBLIC_MINIO_BUCKET="drag-gallery"
NEXT_PUBLIC_MINIO_BASE_URL="http://127.0.0.1:9000/drag-gallery"
